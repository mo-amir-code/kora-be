generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────────

enum UserPlan {
  FREE
  PRO
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum SocialPlatform {
  INSTAGRAM
  YOUTUBE
  TIKTOK
  LINKEDIN
  X
  FACEBOOK
  SNAPCHAT
  PINTEREST
  TWITCH
  OTHER
}

enum BrandCategory {
  TECH
  FASHION
  BEAUTY
  FINANCE
  EDUCATION
  GAMING
  FOOD
  FITNESS
  TRAVEL
  AUTOMOTIVE
  HEALTH
  ENTERTAINMENT
  E_COMMERCE
  SAAS
  OTHER
}

enum DealStage {
  LEAD
  OUTREACH
  NEGOTIATION
  PROPOSAL_SENT
  CONTRACT_SENT
  APPROVED
  IN_PROGRESS
  COMPLETED
  LOST
  CANCELLED
}

enum PaymentTerms {
  ADVANCE_100
  ADVANCE_50
  ON_DELIVERY
  NET_15
  NET_30
  NET_45
  NET_60
  CUSTOM
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  REFUNDED
}

enum DealCurrency {
  INR
  USD
}

enum DeliverableType {
  INSTAGRAM_REEL
  INSTAGRAM_POST
  INSTAGRAM_STORY
  YOUTUBE_SHORT
  YOUTUBE_VIDEO
  TIKTOK_VIDEO
  LINKEDIN_POST
  X_POST
  BLOG_POST
  NEWSLETTER
  LIVE_STREAM
  UGC_VIDEO
  OTHER
}

enum DealActivityType {
  DEAL_CREATED
  DEAL_UPDATED
  STAGE_CHANGED
  CONTACT_CHANGED
  DELIVERABLE_ADDED
  DELIVERABLE_COMPLETED
  CONTRACT_UPLOADED
  INVOICE_CREATED
  INVOICE_SENT
  PAYMENT_RECEIVED
  PAYMENT_REFUNDED
  NOTE_ADDED
  ATTACHMENT_UPLOADED
  REMINDER_SENT
  DEAL_ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum PaymentEventType {
  PAYMENT_RECEIVED
  PARTIAL_PAYMENT
  REFUND
  CHARGEBACK
  ADJUSTMENT
}

enum ReminderTriggerType {
  DELIVERABLE_DUE_SOON
  DELIVERABLE_OVERDUE
  PAYMENT_DUE
  PAYMENT_OVERDUE
  MISSING_INVOICE
}

enum NotificationType {
  DELIVERABLE_REMINDER
  INVOICE_REMINDER
  PAYMENT_REMINDER
  PAYMENT_RECEIVED
  DEAL_UPDATED
  DEAL_COMPLETED
  EXCLUSIVITY_ENDING
  SYSTEM_NOTIFICATION
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SCHEDULED
  SENT
  FAILED
  READ
}

enum MessageTemplateCategory {
  OUTREACH
  FOLLOW_UP
  NEGOTIATION
  CONTRACT
  INVOICE
  PAYMENT_REMINDER
  THANK_YOU
  CUSTOM
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum AttachmentEntityType {
  INVOICE
  DEAL
  BRAND
  DELIVERABLE
}

// ─── GROUP 1: IDENTITY ──────────────────────────────────────────────────────────

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  fullName        String    @map("full_name")
  password        String?
  handle          String?
  avatarUrl       String?   @map("avatar_url")
  whatsappNumber  String?   @map("whatsapp_number")
  plan            UserPlan  @default(FREE)
  planExpiresAt   DateTime? @map("plan_expires_at") @db.Timestamptz
  onboardingDone  Boolean   @default(false) @map("onboarding_done")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  socialProfiles   UserSocialProfile[]
  brands           Brand[]
  deals            Deal[]
  dealActivities   DealActivity[]
  invoices         Invoice[]
  notifications    Notification[]
  reminderRules    ReminderRule[]
  messageTemplates MessageTemplate[]
  subscription     Subscription?
  settings         UserSettings?
  invoiceSettings  UserInvoiceSettings?
  attachments      Attachment[]
  oauthAccounts    OAuthAccount[]
  otps             Otp[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

model OAuthAccount {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  provider     OAuthProvider
  providerId   String        @map("provider_id")
  accessToken  String?       @map("access_token")
  refreshToken String?       @map("refresh_token")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model Otp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserSocialProfile {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  platform      SocialPlatform
  handle        String
  followerCount Int?           @map("follower_count")
  profileUrl    String?        @map("profile_url")
  isPrimary     Boolean        @default(false) @map("is_primary")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_social_profiles")
}

// ─── GROUP 2: BRANDS ────────────────────────────────────────────────────────────

model Brand {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  name        String
  category    BrandCategory
  logoUrl     String?       @map("logo_url")
  website     String?
  gstin       String?
  notes       String[]
  totalDeals  Int           @default(0) @map("total_deals")
  totalEarned Decimal       @default(0) @map("total_earned") @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts BrandContact[]
  deals    Deal[]

  @@map("brands")
}

model BrandContact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  name      String
  role      String?
  email     String?
  whatsapp  String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  brand Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  deals Deal[]

  @@map("brand_contacts")
}

// ─── GROUP 3: DEALS ─────────────────────────────────────────────────────────────

model Deal {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  brandId         String        @map("brand_id") @db.Uuid
  contactId       String?       @map("contact_id") @db.Uuid
  title           String
  stage           DealStage     @default(LEAD)
  amount          Decimal?      @db.Decimal(12, 2)
  currency        DealCurrency  @default(INR)
  paymentTerms    PaymentTerms? @map("payment_terms")
  paymentDueDate  DateTime?     @map("payment_due_date") @db.Date
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  amountPaid      Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  platforms       String[]
  contractUrl     String?       @map("contract_url")
  exclusivityEnds DateTime?     @map("exclusivity_ends") @db.Date
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contact       BrandContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deliverables  Deliverable[]
  activities    DealActivity[]
  invoices      Invoice[]
  paymentEvents PaymentEvent[]
  notifications Notification[]

  @@map("deals")
}

model Deliverable {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId      String          @map("deal_id") @db.Uuid
  type        DeliverableType
  quantity    Int             @default(1) @db.SmallInt
  platform    String?
  dueDate     DateTime?       @map("due_date") @db.Date
  isCompleted Boolean         @default(false) @map("is_completed")
  completedAt DateTime?       @map("completed_at") @db.Timestamptz
  postUrl     String?         @map("post_url")
  notes       String?

  // Relations
  deal          Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@map("deliverables")
}

model DealActivity {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId    String           @map("deal_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      DealActivityType
  body      String?
  meta      Json?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("deal_activities")
}

// ─── GROUP 4: INVOICES & PAYMENTS ───────────────────────────────────────────────

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  dealId        String        @map("deal_id") @db.Uuid
  invoiceNumber String        @map("invoice_number")
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(12, 2)
  gstRate       Decimal?      @map("gst_rate") @db.Decimal(5, 2)
  gstAmount     Decimal?      @map("gst_amount") @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  issuedDate    DateTime      @map("issued_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz
  pdfUrl        String?       @map("pdf_url")
  viewedAt      DateTime?     @map("viewed_at") @db.Timestamptz
  notes         String?

  // Relations
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal          Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lineItems     InvoiceLineItem[]
  paymentEvents PaymentEvent[]

  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String
  quantity    Int     @default(1) @db.SmallInt
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order") @db.SmallInt

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

model PaymentEvent {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId    String           @map("deal_id") @db.Uuid
  invoiceId String?          @map("invoice_id") @db.Uuid
  type      PaymentEventType
  amount    Decimal          @db.Decimal(12, 2)
  method    String?
  reference String?
  paidAt    DateTime         @map("paid_at") @db.Timestamptz

  // Relations
  deal    Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("payment_events")
}

// ─── GROUP 5: NOTIFICATIONS ─────────────────────────────────────────────────────

model ReminderRule {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  name            String?
  triggerType     ReminderTriggerType @map("trigger_type")
  offsetValue     Int                 @map("offset_value")
  offsetUnit      String              @map("offset_unit") @default("hours")
  nextFollowUps   String[]            @map("next_follow_ups")
  recipients      String[]            @default([]) @map("recipients")
  messageTemplate String?             @map("message_template")
  channelEmail    Boolean             @default(true) @map("channel_email")
  channelWhatsapp Boolean             @default(false) @map("channel_whatsapp")
  channelPush     Boolean             @default(true) @map("channel_push")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminder_rules")
}

model Notification {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  dealId        String?             @map("deal_id") @db.Uuid
  deliverableId String?             @map("deliverable_id") @db.Uuid
  type          NotificationType
  channel       NotificationChannel
  title         String
  body          String?
  status        NotificationStatus  @default(PENDING)
  scheduledFor  DateTime?           @map("scheduled_for") @db.Timestamptz
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz
  readAt        DateTime?           @map("read_at") @db.Timestamptz

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// ─── GROUP 6: SETTINGS & BILLING ────────────────────────────────────────────────

model MessageTemplate {
  id         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                  @map("user_id") @db.Uuid
  category   MessageTemplateCategory
  name       String
  body       String
  channels   String[]
  isSystem   Boolean                 @default(false) @map("is_system")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("message_templates")
}

model Subscription {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String             @unique @map("user_id") @db.Uuid
  plan             SubscriptionPlan   @default(FREE)
  billingCycle     BillingCycle       @default(MONTHLY) @map("billing_cycle")
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime?          @map("trial_ends_at") @db.Timestamptz
  currentPeriodEnd DateTime?          @map("current_period_end") @db.Timestamptz
  razorpaySubId    String?            @map("razorpay_sub_id")
  amountPaid       Decimal            @default(0) @map("amount_paid") @db.Decimal(12, 2)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UserInvoiceSettings {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String  @unique @map("user_id") @db.Uuid
  invoicePrefix  String? @map("invoice_prefix")
  nextInvoiceNum Int     @default(1) @map("next_invoice_num")
  gstin          String?
  upiId          String? @map("upi_id")
  bankIfsc       String? @map("bank_ifsc")
  bankAccount    String? @map("bank_account")
  logoUrl        String? @map("logo_url")
  footerText     String? @map("footer_text")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_invoice_settings")
}

model UserSettings {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String  @unique @map("user_id") @db.Uuid
  timezone     String? @default("UTC")
  baseCurrency String? @default("USD") @map("base_currency")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─── ATTACHMENTS ────────────────────────────────────────────────────────────────

model Attachment {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType AttachmentEntityType @map("entity_type")
  entityId   String               @map("entity_id") @db.Uuid
  fileName   String               @map("file_name")
  fileUrl    String               @map("file_url")
  mimeType   String?              @map("mime_type")
  fileSize   BigInt?              @map("file_size")
  createdBy  String               @map("created_by") @db.Uuid
  uploadedAt DateTime             @default(now()) @map("uploaded_at") @db.Timestamptz

  // Relations
  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("attachments")
}
